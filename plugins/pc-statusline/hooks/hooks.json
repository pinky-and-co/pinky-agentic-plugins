{
  "description": "Keep the active non-Anthropic provider's quota cache fresh for the status line's rate-limit warning. Async (never adds latency) and a no-op on Anthropic.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/quota_refresh.py\" session",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/quota_refresh.py\" prompt",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/quota_refresh.py\" tool",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/quota_refresh.py\" stop",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ]
  }
}
