{
  "description": "Enforces the careful/freeze/deny/guard permission guards (toggled by the permission-change skill), freezes an orchestrator session (cwd outside any git repo) to the kanban boards on SessionStart, asks before writing a kanban card still being framed (0-ideas, 1-todo, 2-selected-for-dev), keeps the in-progress kanban card's handoff fresh on Stop and SessionEnd, and on SessionEnd hands a working session's missing cross-agent log entry to a headless writer — injects the kanban-proactivity rule into the main session on SessionStart (startup, compact, clear) — see kanban-proactivity/kanban_proactivity.py, guard.py, orchestrator_freeze.py, card-discipline/card_discipline.py, stop_handoff.py, agent_log_writer.py. Runs the deterministic skill scripts of `init`, `permission-change` and `move-card` directly, with no model call, when typed with conforming arguments (UserPromptExpansion).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/kanban-proactivity/kanban_proactivity.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/orchestrator_freeze.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/permission-change/scripts/guard.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/card-discipline/card_discipline.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/stop_handoff.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/stop_handoff.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/agent_log_writer.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "^pc-kanban:init$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/pc_kanban_direct_command_runner.py\" --script \"${CLAUDE_PLUGIN_ROOT}/skills/init/scripts/pc_kanban_init.py\" --interpreter python3 --grammar '{\"forms\":[{\"match\":[],\"emit\":[]},{\"match\":[\"--workspace\",{\"re\":\"[\\\\w@%+:,./][\\\\w@%+=:,./-]*\"}],\"emit\":[\"--workspace\",\"{1}\"]}]}'",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "^pc-kanban:permission-change$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/pc_kanban_direct_command_runner.py\" --script \"${CLAUDE_PLUGIN_ROOT}/skills/permission-change/scripts/guard.py\" --interpreter python3 --grammar '{\"forms\":[{\"match\":[\"status\"],\"emit\":[\"status\"]},{\"match\":[\"careful\"],\"emit\":[\"careful\"]},{\"match\":[\"careful\",{\"re\":\"on|off\"}],\"emit\":[\"careful\",\"{1}\"]},{\"match\":[{\"re\":\"freeze|deny|guard\"},{\"re\":\"[\\\\w@%+:,./][\\\\w@%+=:,./-]*\",\"repeat\":true}],\"emit\":[\"{*}\"]}]}'",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "^pc-kanban:move-card$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/pc_kanban_direct_command_runner.py\" --script \"${CLAUDE_PLUGIN_ROOT}/hooks/card-ops/pc_kanban_card_ops.py\" --interpreter python3 --grammar '{\"forms\":[{\"match\":[\"select\",{\"re\":\"\\\\w[\\\\w.-]*\"}],\"emit\":[\"select\",\"{1}\"]},{\"match\":[\"select\",{\"re\":\"\\\\w[\\\\w.-]*\"},\"--force\"],\"emit\":[\"select\",\"{1}\",\"--force\"]},{\"match\":[\"archive\",{\"re\":\"\\\\w[\\\\w.-]*\"}],\"emit\":[\"archive\",\"{1}\"]},{\"match\":[\"drop\",{\"re\":\"\\\\w[\\\\w.-]*\"},{\"re\":\"[^\\\\s]+\",\"repeat\":true,\"allow_dash\":true}],\"emit\":[\"{*}\"]}]}'",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "modules": [
    "./board-pane/register.tsx"
  ]
}
