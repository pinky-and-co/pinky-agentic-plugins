{
  "description": "Blocks a guarded write on a permanent branch — see branch_guard.py. Guards against overlapping PRs — see pr_overlap_guard.py. Starts every session on a clean, up-to-date base (fast-forward, [gone] branches removed) on SessionStart — see clean-gone/clean_gone_hook.py",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/branch-policy/branch_guard.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/pr-overlap/pr_overlap_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/clean-gone/clean_gone_hook.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
