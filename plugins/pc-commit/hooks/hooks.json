{
  "description": "Injects per-repo resolved policies (language, branch) before every write — see hooks/inject_policies.py",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/inject_policies.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
